        i += 1
    validate(cfg)

    paths, missing = resolve_programs(cfg)
    if missing:
        fail(
            "missing: " + ", ".join(missing) + "\n"
            "Install with Homebrew, then run init again:\n"
            "  brew install " + " ".join(
                {"snapserver": "snapcast"}.get(m, m) for m in missing
