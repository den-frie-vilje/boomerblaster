# ---------------------------------------------------------------- helpers

def say(msg=""):
    print(msg)


def fail(msg, code=1):
    print("boomerblaster: " + msg, file=sys.stderr)
    sys.exit(code)


def which(name):
    """Find a program on PATH, then in the usual Homebrew prefixes, which
    launchd does not put on PATH."""
    found = shutil.which(name)
    if found:
        return found
    for prefix in ("/opt/homebrew/bin", "/usr/local/bin", "/home/linuxbrew/.linuxbrew/bin"):
        candidate = os.path.join(prefix, name)
        if os.access(candidate, os.X_OK):
            return candidate
    return None


def load_config():
    cfg = dict(DEFAULTS)
    if os.path.exists(CONFIG_PATH):
        with open(CONFIG_PATH) as fh:
            try:
                cfg.update(json.load(fh))
            except json.JSONDecodeError as exc:
                fail(f"{CONFIG_PATH} is not valid JSON: {exc}")
    return cfg


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_PATH, "w") as fh:
        json.dump(cfg, fh, indent=2, sort_keys=True)
        fh.write("\n")


def validate(cfg):
    if cfg["codec"] not in CODECS:
        fail(f"codec must be one of {', '.join(CODECS)}, not {cfg['codec']!r}")
    if cfg.get("airplay_version", 2) not in (1, 2):
        fail("airplay_version must be 2 (AirPlay 2) or 1 (classic AirPlay)")
    if cfg["spotify_bitrate"] not in (96, 160, 320):
        fail("spotify_bitrate must be 96, 160 or 320")
    if not (cfg["airplay"] or cfg["spotify"]):
        fail("at least one of airplay and spotify must be on")
    ports = (cfg["http_port"], cfg["stream_port"], cfg["control_port"])
    if len(set(ports)) != 3:
        fail("http_port, stream_port and control_port must differ")
    for p in ports:
        if not 1 <= p <= 65535:
            fail(f"port {p} is out of range")


def local_hostname():
    if DARWIN:
        try:
            out = subprocess.run(
                ["scutil", "--get", "LocalHostName"],
                capture_output=True, text=True, check=True,
            ).stdout.strip()
            if out:
                return out + ".local"
        except (OSError, subprocess.CalledProcessError):
            pass
    name = socket.gethostname()
    return name if name.endswith(".local") else name.split(".")[0] + ".local"


def local_ip():
    """The address of the interface that reaches the LAN. No packet is
    sent; connecting a UDP socket only picks the route."""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("10.255.255.255", 1))
        return s.getsockname()[0]
    except OSError:
        return None
    finally:
        s.close()


def port_open(port, host="127.0.0.1", timeout=0.5):
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def airplay_port_holder(port=AIRPLAY_PORT):
    """The command listening on the given TCP port, or None.

    macOS's own AirPlay Receiver (the ControlCenter process) holds 7000,
    AirPlay 2's port, when it is on (and 5000, classic AirPlay's), so it
    and shairport-sync cannot share a Mac.
    """
    if not DARWIN:
        return None
    res = subprocess.run(
        ["/usr/sbin/lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-Fc"],
        capture_output=True, text=True,
    )
    for line in res.stdout.splitlines():
        if line.startswith("c"):
            return line[1:]
    return None


def airplay_port_problem(cfg):
    """What stands in AirPlay's way, as a message, or None."""
    if not (DARWIN and cfg["airplay"]):
        return None
    port = airplay_port(cfg)
    holder = airplay_port_holder(port)
    if holder is None or holder.startswith("shairport"):
        return None
    if holder == "ControlCenter":
        return (
            f"macOS's own AirPlay Receiver is on and holds port {port}, which shairport-sync needs.\n"
            "Turn it off in System Settings > General > AirDrop & Handoff > AirPlay Receiver,\n"
            "or keep it and turn this half off with: boomerblaster set airplay false"
        )
    return (
        f"port {port} is held by {holder!r}, which shairport-sync needs.\n"
        "Stop that program, or turn AirPlay off with: boomerblaster set airplay false"
    )


def airplay2_build(path):
    """Whether this shairport-sync is built for AirPlay 2 (its -V string
    carries an AirPlay2 tag)."""
    try:
        out = subprocess.run([path, "-V"], capture_output=True, text=True).stdout
    except OSError:
        return False
    return "AirPlay2" in out


def nqptp_running():
    """Whether nqptp, the PTP timing daemon AirPlay 2 relies on, is up."""
    res = subprocess.run(["/usr/bin/pgrep", "-x", "nqptp"], capture_output=True)
    return res.returncode == 0


def nqptp_problem(cfg):
    """What stands in AirPlay 2's way, as a message, or None.

    An AirPlay-2 shairport-sync will not start without nqptp, and
    snapserver would respawn it into the same wall; a classic build
    needs nothing. boomerblaster never sudos; on macOS none is needed,
    nqptp runs as you.
    """
    if not cfg["airplay"] or airplay_classic(cfg):
        return None
    path = which("shairport-sync")
    if not path or not airplay2_build(path) or nqptp_running():
        return None
    return (
        "shairport-sync is built for AirPlay 2, which needs the nqptp timing daemon,\n"
        "and nqptp is not running. boomerblaster start starts it; under another\n"
        "supervisor, start it yourself: brew services start nqptp\n"
        "(not installed? brew install den-frie-vilje/tap/nqptp first;\n"
        " paused it to cast from this Mac? boomerblaster cast off)"
    )


def ptp_ports_held_by(pid_filter=None):
    """Who holds UDP 319/320 (the PTP ports), as a set of process names."""
    res = subprocess.run(["/usr/sbin/lsof", "-nP", "-iUDP:319", "-iUDP:320", "-Fc"],
                         capture_output=True, text=True)
    names = {line[1:] for line in res.stdout.splitlines() if line.startswith("c")}
    return names


def write_conf(cfg):
    paths, missing = resolve_programs(cfg)
    if missing:
        fail("missing: " + ", ".join(missing) + "; install and run boomerblaster init")
    with open(SNAPSERVER_CONF, "w") as fh:
        fh.write(render_conf(cfg, paths))


def nqptp_start():
    """Start nqptp as a Homebrew service and wait until it is up."""
    brew = which("brew")
    if not brew:
        fail("Homebrew is needed to start and stop nqptp")
    holders = ptp_ports_held_by()
    if holders:
        fail(f"the PTP ports AirPlay 2 needs are in use by {', '.join(sorted(holders))};\n"
             "stop casting from this Mac first, or receive classic AirPlay: boomerblaster cast on")
    res = subprocess.run([brew, "services", "start", "nqptp"], capture_output=True, text=True)
    if res.returncode != 0:
        fail("brew services start nqptp failed: " + (res.stderr.strip() or res.stdout.strip()))
    for _ in range(20):
        if nqptp_running():
            break
        time.sleep(0.25)
    else:
        fail("nqptp did not come up; see brew services info nqptp")
    say("nqptp running")


def nqptp_stop():
    """Stop nqptp, which gives this Mac's own AirPlay sender its PTP ports back."""
    brew = which("brew")
    if not brew:
        fail("Homebrew is needed to start and stop nqptp")
    res = subprocess.run([brew, "services", "stop", "nqptp"], capture_output=True, text=True)
    if res.returncode != 0:
        fail("brew services stop nqptp failed: " + (res.stderr.strip() or res.stdout.strip()))
    say("nqptp stopped")


def cmd_cast(args):
    """Flip the Mac between receiving AirPlay 2 and casting AirPlay itself.

    Both sides of AirPlay 2 want UDP 319 and 320 for their PTP clock:
    nqptp, which the receiver follows, and macOS's own sender. One Mac
    cannot hold them twice. Classic AirPlay needs no PTP, so `cast on`
    drops the receiver to classic, stops nqptp and restarts the server:
    phones still cast to it (AirPlay-2-only apps no longer list it) and
    this Mac can cast to other speakers. `cast off` reverses that.
    """
    if not DARWIN:
        fail("cast is macOS-only")
    if args and args[0] not in ("on", "off"):
        fail("usage: boomerblaster cast [on|off]")
    cfg = load_config()
    running = nqptp_running()
    classic = airplay_classic(cfg)
    if not args:
        if not running and not launchd_loaded():
            say("the server is stopped and so is nqptp; this Mac can cast to other speakers")
        elif classic and not running:
            say("cast on: the receiver is classic AirPlay, nqptp is stopped; this Mac can cast to other speakers")
        elif not classic and running:
            say("cast off: the receiver is AirPlay 2 (nqptp running); this Mac cannot cast to other speakers")
        else:
            say(f"half-way: receiver is {'classic AirPlay' if classic else 'AirPlay 2'}, nqptp is "
                f"{'running' if running else 'stopped'}; run boomerblaster cast on, or cast off")
        holders = ptp_ports_held_by() - {"nqptp"}
        if holders:
            say(f"PTP ports in use by {', '.join(sorted(holders))}")
        return
    brew = which("brew")
    if not brew:
        fail("Homebrew is needed to start and stop nqptp")
    if args[0] == "on":
        if classic and not running:
            say("already set to cast")
            return
        if running:
            nqptp_stop()
        if not classic:
            cfg["airplay_version"] = 1
            save_config(cfg)
            write_conf(cfg)
            say("receiver set to classic AirPlay")
            if launchd_loaded():
                cmd_restart([])
            else:
                say("run boomerblaster restart (or start) to apply")
        say("This Mac can now cast AirPlay to other speakers. Phones still cast to "
            f"\"{cfg['name']}\" (classic AirPlay; AirPlay-2-only apps will not list it).")
        say("Back to AirPlay 2: boomerblaster cast off")
    else:
        loaded = launchd_loaded()
        if not classic and (running or not loaded):
            say("already set to receive AirPlay 2")
            return
        if classic:
            cfg["airplay_version"] = 2
            save_config(cfg)
            write_conf(cfg)
            say("receiver set to AirPlay 2")
        # nqptp runs only alongside the server; start brings it up.
        if loaded:
            cmd_restart([])
        else:
            say("run boomerblaster start to apply")
        say(f"Phones can AirPlay 2 to \"{cfg['name']}\" again. This Mac cannot cast to other speakers until boomerblaster cast on.")


# -------------------------------------------------------- snapserver.conf

def render_conf(cfg, paths):
    """Write the snapserver.conf that expresses the settings.

    Both receivers deliver 44.1 kHz stereo, so the streams are declared
    at that rate and nothing is resampled. The `meta` stream wraps the
    two receivers so that listeners sit on one stream, named after the
    venue, and hear whichever source is playing; the first in its list
    wins when both play at once. It is the default source, so a new
    listener joins it rather than the first receiver's own stream.
    """
    name = quote(cfg["name"], safe="")
    sources = []
    order = []
    if cfg["airplay"]:
        # An AirPlay-2 shairport-sync answers classic AirPlay too; asked for
        # classic only, it needs no PTP clock (nqptp) and leaves the PTP
        # ports to this Mac's own AirPlay sender.
        sources.append(
            f"source = airplay://{paths['shairport-sync']}?name=AirPlay"
            f"&devicename={name}&port={airplay_port(cfg)}"
            + ("&params=--service-type=classic" if airplay_classic(cfg) else "")
        )
        order.append("AirPlay")
    if cfg["spotify"]:
        sources.append(
            f"source = librespot://{paths['librespot']}?name=Spotify"
            f"&devicename={name}&bitrate={cfg['spotify_bitrate']}"
            "&killall=false&wd_timeout=7800"
        )
        order.append("Spotify")
    if cfg["sysaudio"]:
        # Whatever plays on this Mac, via the virtual device. The capture
        # streams continuously (silence when nothing plays), so it never goes
        # idle; it sits LAST in the meta order, a baseline the receivers beat
        # when they are active. Its control script supplies the track from
        # macOS Now Playing.
        write_capture(cfg)
        sources.append(
            f"source = process://{CAPTURE_PATH}?name=System"
            "&sampleformat=44100:16:2"
            "&controlscript=meta_nowplaying.py"
            f"&controlscriptparams=--picker {picker_port(cfg)} --tap-file {TAP_FILE}"
            "&log_stderr=true"
        )
        order.append("System")
    sources.append(f"source = meta:///{'/'.join(order)}?name={name}")
    lines = [
        "# Generated by boomerblaster; edit ~/.config/boomerblaster/config.json",
        "# and run `boomerblaster init` instead of editing this file.",
        "",
        "[server]",
        "threads = -1",
        f"datadir = {STATE_DIR}",
        "",
        "[http]",
        "enabled = true",
        f"port = {cfg['http_port']}",
        f"doc_root = {WWW_DIR}",
        # The name snapserver puts in its cover-art links; without it, the
        # links carry a bare hostname other devices cannot resolve.
        f"host = {local_hostname()}",
        "",
        "[tcp]",
        "enabled = true",
        f"port = {cfg['control_port']}",
        "",
        "[stream]",
        f"port = {cfg['stream_port']}",
        # New listeners land on the venue stream, not on the first receiver.
        f"default_source = {cfg['name']}",
        "sampleformat = 44100:16:2",
        f"codec = {cfg['codec']}",
        f"buffer = {cfg['buffer_ms']}",
        "chunk_ms = 20",
        "send_to_muted = false",
        *([f"plugin_dir = {plugin_dir()}"] if cfg["sysaudio"] and plugin_dir() else []),
        *sources,
        "",
        "[logging]",
        "sink = stderr",
        "filter = *:info",
        "",
    ]
    return "\n".join(lines)


def required_programs(cfg):
    programs = ["snapserver"]
    if cfg["airplay"]:
        programs.append("shairport-sync")
    if cfg["spotify"]:
        programs.append("librespot")
    return programs


def resolve_programs(cfg):
    paths = {}
    missing = []
    for prog in required_programs(cfg):
        path = which(prog)
        if path:
            paths[prog] = path
        else:
            missing.append(prog)
    return paths, missing


# ---------------------------------------------------------------- snapweb

def listener_source():
    """Where the built listener page lives: next to the Homebrew binary,
    in a clone, or where install.sh put it."""
    here = os.path.dirname(os.path.realpath(__file__))
    for candidate in (
        os.path.join(here, "..", "share", "boomerblaster", "listener"),
        os.path.join(here, "listener", "dist"),
        os.path.join(DATA_DIR, "listener"),
    ):
        candidate = os.path.normpath(candidate)
        if os.path.exists(os.path.join(candidate, "index.html")):
            return candidate


def plugin_dir():
    """Where the Snapcast control scripts live (the now-playing metadata
    reader): next to the Homebrew binary, in a clone, or where install.sh
    put them."""
    here = os.path.dirname(os.path.realpath(__file__))
    for candidate in (
        os.path.join(here, "..", "share", "boomerblaster", "plug-ins"),
        os.path.join(here, "plug-ins"),
        os.path.join(DATA_DIR, "plug-ins"),
    ):
        candidate = os.path.normpath(candidate)
        if os.path.exists(os.path.join(candidate, "meta_nowplaying.py")):
            return candidate
    return None


