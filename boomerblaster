def capture_source():
    """The helper's source directory: in a clone, where the formula put it,
    or where install.sh put it."""
    here = os.path.dirname(os.path.realpath(__file__))
    for candidate in (
        os.path.join(here, "capture"),
        os.path.join(here, "..", "share", "boomerblaster", "capture"),
        os.path.join(DATA_DIR, "capture"),
    ):
        candidate = os.path.normpath(candidate)
        if os.path.exists(os.path.join(candidate, CAPTURE_HELPER + ".m")):
            return candidate
    return None


def capture_helper(build=False):
    """Where the built capture helper is: next to the Homebrew binary, in a
    clone after `make -C capture`, or built by init into the data directory.
    With build=True a missing helper is compiled from source, or init fails
    with the reason."""
    here = os.path.dirname(os.path.realpath(__file__))
    for candidate in (
        os.path.join(here, "..", "libexec", "boomerblaster", CAPTURE_HELPER),
        os.path.join(here, "capture", CAPTURE_HELPER),
        os.path.join(DATA_DIR, CAPTURE_HELPER),
    ):
        candidate = os.path.normpath(candidate)
        if os.access(candidate, os.X_OK):
            return candidate
    if not build:
        return None
    return build_capture_helper()


def build_capture_helper():
    """Compiles the helper into the data directory. Needs the Xcode command
    line tools (clang), which Homebrew needs anyway."""
    src = capture_source()
    if not src:
        fail(
            "the capture helper is missing and its source is not here either;\n"
            "reinstall boomerblaster, or run `make -C capture` in a clone"
        )
    clang = which("clang")
    if not clang:
        fail(
            "building the capture helper needs the Xcode command line tools:\n"
            "  xcode-select --install\n"
            "then run boomerblaster init again"
        )
    os.makedirs(DATA_DIR, exist_ok=True)
    target = os.path.join(DATA_DIR, CAPTURE_HELPER)
    argv = [clang, "-O2", "-Wall", "-fobjc-arc", "-mmacosx-version-min=12.0"]
    for fw in CAPTURE_FRAMEWORKS:
        argv += ["-framework", fw]
    argv += ["-sectcreate", "__TEXT", "__info_plist", os.path.join(src, "Info.plist"),
             "-o", target, os.path.join(src, CAPTURE_HELPER + ".m")]
    say("building the capture helper (once)...")
    res = subprocess.run(argv, capture_output=True, text=True)
    if res.returncode != 0:
        fail("building the capture helper failed:\n" + res.stderr.strip())
    say(f"capture helper built at {target}")
    return target


def write_capture(cfg):
    helper = capture_helper(build=True)
    device = cfg["sysaudio_device"]
    # The helper reads the virtual device through CoreAudio, measures the
    # device's clock against the system clock from the HAL's timestamps,
    # resamples to 44.1 kHz at the ratio that keeps the two locked, and writes
    # the PCM to stdout paced to real time, so snapserver's process source
    # always finds the next chunk ready and never resyncs. See capture/ for
    # the source and its end-to-end tests.
    script = (
        "#!/bin/sh\n"
        "# Generated by boomerblaster. Captures the virtual audio device, or the\n"
        "# application named in capture-app, clock-locked, and writes raw PCM\n"
        "# (s16le 44100 stereo) to stdout.\n"
        f'exec "{helper}" --device "{device}" --tap-file "{TAP_FILE}" --rate 44100\n'
    )
    with open(CAPTURE_PATH, "w") as fh:
        fh.write(script)
    os.chmod(CAPTURE_PATH, 0o755)
    write_tap_file(cfg)
    return None


def write_tap_file(cfg):
    """The capture helper re-reads this file within a second of a change."""
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(TAP_FILE, "w") as fh:
        fh.write(cfg.get("sysaudio_app", "") + "\n")
        if cfg.get("sysaudio_app") and cfg.get("sysaudio_app_mute"):
            fh.write("mute\n")


def cmd_capture_app(args):
    """capture-app [NAME|device]: which application's sound the System
    source carries. Takes effect within a second, no restart."""
    cfg = load_config()
    mute_flags = {"--mute": True, "--unmute": False}
    for flag, value in mute_flags.items():
        if flag in args:
            cfg["sysaudio_app_mute"] = value
            args = [a for a in args if a != flag]
    if not args and any(f in sys.argv for f in mute_flags):
        validate(cfg)
        save_config(cfg)
        write_tap_file(cfg)
        say(f"the captured app is {'silenced on this Mac' if cfg['sysaudio_app_mute'] else 'audible on this Mac'}")
        return
    if not args:
        current = cfg.get("sysaudio_app", "")
        say((f"capturing {current!r}" + (", silenced on this Mac" if cfg.get("sysaudio_app_mute") else ""))
            if current else f"capturing the device \"{cfg['sysaudio_device']}\"")
        helper = capture_helper()
        if helper:
            res = subprocess.run([helper, "--list-apps"], capture_output=True, text=True)
            try:
                apps = json.loads(res.stdout)
            except json.JSONDecodeError:
                apps = []
            playing = [a for a in apps if a.get("playing")]
            if playing:
                say("apps making sound now:")
                for a in playing:
                    say(f"  {a['name']:<32} {a.get('bundle', '')}")
        if cfg["sysaudio"]:
            say(f"picker page: http://{local_hostname()}:{picker_port(cfg)}/")
        return
    value = " ".join(args).strip()
    if value.lower() in ("device", "off", "none", "blackhole"):
        value = ""
    if value.startswith("-") or len(value) > 200:
        fail("that does not look like an application name or bundle id")
    cfg["sysaudio_app"] = value
    validate(cfg)
    save_config(cfg)
    write_tap_file(cfg)
    if not cfg["sysaudio"]:
        say(f"saved; the System source is off, turn it on with: boomerblaster set sysaudio true")
    elif value:
        say(f"capturing {value!r}{', silenced on this Mac' if cfg.get('sysaudio_app_mute') else ''}; "
            "the capture follows within a second (needs macOS 14.2)")
    else:
        say(f"capturing the device \"{cfg['sysaudio_device']}\" again")


