def cmd_run(_args):
    cfg = load_config()
    ensure_initialised(cfg)
    snapserver = which("snapserver")
    if not snapserver:
        fail("snapserver is not installed; brew install snapcast")
    for problem in (airplay_port_problem(cfg), nqptp_problem(cfg)):
        # Keep serving Spotify and the page; under launchd a hard exit
        # here would just have launchd respawn us into the same wall.
        if problem:
            say("warning: " + problem)
    argv = [snapserver, "-c", SNAPSERVER_CONF]
    caffeinate = which("caffeinate") if DARWIN else None
    if caffeinate:
        # Keep the Mac from idle-sleeping while the server runs; the
        # display may still sleep. A sleeping laptop is a silent office.
        argv = [caffeinate, "-i"] + argv
    sys.stdout.flush()
    os.execv(argv[0], argv)


def cmd_start(args):
    cfg = load_config()
    ensure_initialised(cfg)
    if not DARWIN:
        fail("start uses launchd and is macOS-only; run `boomerblaster run` under your own supervisor")
    if args:
        fail(f"start: unknown argument {args[0]!r}")
    if launchd_loaded():
        say("already running (LaunchAgent loaded); use restart to apply changes")
        return
    problem = airplay_port_problem(cfg)
    if problem:
        fail(problem)
    if nqptp_problem(cfg):
        nqptp_start()
    write_plist()
    res = subprocess.run(
        ["launchctl", "bootstrap", f"gui/{os.getuid()}", PLIST_PATH],
        capture_output=True, text=True,
    )
    if res.returncode != 0:
        fail("launchctl bootstrap failed: " + (res.stderr.strip() or res.stdout.strip()))
    for _ in range(40):
        if port_open(cfg["http_port"]):
            break
        time.sleep(0.25)
    else:
        say(f"started, but port {cfg['http_port']} is not answering yet; see boomerblaster logs")
        return
    say("running, and again after every login, until boomerblaster stop")
    print_urls(cfg)


def cmd_stop(_args, restarting=False):
    if not DARWIN:
        fail("stop is macOS-only; signal the `boomerblaster run` process you started")
    if launchd_loaded():
        subprocess.run(["launchctl", "bootout", launchd_target()], capture_output=True)
        say("stopped")
    else:
        say("not running")
    if os.path.exists(PLIST_PATH):
        os.remove(PLIST_PATH)
        say("LaunchAgent removed")
    # A snapserver that died without a stop leaves its receivers orphaned
    # under launchd, still holding AirPlay's port and the device names.
    for prog in ("shairport-sync", "librespot"):
        for pid in orphans(prog, load_config()["name"]):
            os.kill(pid, signal.SIGTERM)
            say(f"stopped a leftover {prog} (pid {pid})")
    # nqptp holds the PTP ports this Mac's own AirPlay sender needs, so it
    # runs only alongside the server.
    if nqptp_running():
        nqptp_stop()
    if not restarting and load_config()["airplay"]:
        say("This Mac casts AirPlay as normal again. If you turned off its own AirPlay Receiver\n"
            "for BoomerBlaster, turn it back on in System Settings > General > AirDrop & Handoff.")


def orphans(prog, name):
    """PIDs of this receiver's processes whose server is gone (parent launchd)."""
    # comm is cut at 16 characters, so the executable is read from args.
    res = subprocess.run(["/bin/ps", "-axww", "-o", "pid=,ppid=,args="],
                         capture_output=True, text=True, errors="replace")
    pids = []
    for line in res.stdout.splitlines():
        parts = line.split(None, 3)
        if len(parts) < 4:
            continue
        pid, ppid, exe, rest = parts
        if ppid == "1" and os.path.basename(exe) == prog and name in rest:
            pids.append(int(pid))
    return pids


def cmd_restart(args):
    cmd_stop([], restarting=True)
    time.sleep(0.5)
    cmd_start(args)


